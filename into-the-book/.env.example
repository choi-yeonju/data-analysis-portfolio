# 이 파일을 복사해서 같은 폴더에 .env 로 저장한 뒤 값을 채운다.
# .env 는 .gitignore 에 있어서 올라가지 않는다. 이 .env.example 은 빈 칸 그대로 올린다.

# 네이버 데이터랩 (검색어트렌드)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# YES24 Open API (developers.yes24.com, 즉시 발급)
YES24_API_KEY=

# 알라딘 OpenAPI는 2026-11-01 종료됨

# 국립중앙도서관 ISBN 서지정보 (발급 후)
NL_CERT_KEY=
